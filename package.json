{
  "name": "quicksilver-monorepo",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @quicksilver/desktop tauri dev",
    "build": "pnpm --filter @quicksilver/desktop build",
    "tauri": "pnpm --filter @quicksilver/desktop tauri",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm version:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9"
  }
}
